{
  "format": "simcraft",
  "version": 1,
  "comment": "Åström–Hägglund relay feedback auto-tuning limit-cycle oscillation on plant G(s) = 1/(s+1)^3.",
  "solver": {
    "solver": "rk45",
    "dt": 0.01,
    "tstop": 25.0,
    "rtol": 1e-6,
    "atol": 1e-8
  },
  "blocks": [
    {
      "path": "ref",
      "type": "constant",
      "params": {
        "value": 0.0
      }
    },
    {
      "path": "sum",
      "type": "sum",
      "params": {
        "signs": "+-"
      }
    },
    {
      "path": "relay",
      "type": "relay",
      "params": {
        "on_switch": 0.05,
        "off_switch": -0.05,
        "on_output": 1.0,
        "off_output": -1.0,
        "initial_output": 1.0
      }
    },
    {
      "path": "plant",
      "type": "transfer_fcn",
      "params": {
        "num": [1.0],
        "den": [1.0, 3.0, 3.0, 1.0]
      }
    },
    {
      "path": "scope",
      "type": "scope"
    },
    {
      "path": "save_y",
      "type": "to_workspace",
      "params": {
        "var": "y"
      }
    },
    {
      "path": "save_u",
      "type": "to_workspace",
      "params": {
        "var": "u"
      }
    }
  ],
  "wires": [
    {
      "from": "ref/1",
      "to": "sum/1"
    },
    {
      "from": "plant/1",
      "to": "sum/2"
    },
    {
      "from": "sum/1",
      "to": "relay/1"
    },
    {
      "from": "relay/1",
      "to": "plant/1"
    },
    {
      "from": "plant/1",
      "to": "scope/1"
    },
    {
      "from": "plant/1",
      "to": "save_y/1"
    },
    {
      "from": "relay/1",
      "to": "save_u/1"
    }
  ],
  "layout": {
    "ref": [80, 140],
    "sum": [220, 140],
    "relay": [360, 140],
    "plant": [520, 140],
    "scope": [680, 140],
    "save_y": [680, 260],
    "save_u": [440, 260]
  }
}
